#!/bin/sh
# A stand-in for a live runner, used only to hold a slot in the slot-gate
# tests.
#
# The gate does not trust a PID alone: after a pod restart a recycled PID
# would make a dead slot look permanently held, wedging every subsystem at
# once. So it also checks that the owner's cmdline still looks like one of our
# runners. A test that seeds a slot with its own shell PID therefore sees the
# slot correctly reaped — which is the gate working, not failing.
#
# This script exists so a test can occupy a slot with something the gate
# accepts as alive. It only sleeps.
sleep "${1:-30}"
