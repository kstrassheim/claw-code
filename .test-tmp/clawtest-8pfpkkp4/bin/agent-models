#!/bin/sh
# agent-models: read and change which LLM each subsystem runs on, at runtime.
#
# Backs the `model` commands of the developer / tester / reviewer chat skills.
# Writes ~/.openclaw/agent-models.conf on the workspace PVC, which
# builder/agent-models.sh reads at the start of every runner — so a change
# applies to the NEXT spawned run, with nothing restarted and nothing
# redeployed. dev and prod have separate PVCs, so a change here is confined to
# the environment it was made in.
#
# Usage:
#   agent-models list
#   agent-models get   <key>
#   agent-models set   <key>|all <model-id>|default
#   agent-models reset <key>|all
#   agent-models available
#
# Keys:
#   solver          the issue solver's agent turns
#   solver.small    implementing a small story, when set
#   planning        story-point estimation and sprint planning
#   tester          the deployment tester's run
#   reviewer        the pull-request reviewer's run
#   reviewer.small  reviewing a small story's pull request, when set
#
# A model id is what `openclaw models list` prints: kimi/k3,
# minimax/MiniMax-M3, mistral/mistral-large-latest. The word `default` hands
# the key back to the global default from the config — which is what every key
# starts as, so an untouched deployment behaves as it always did.
#
# Exit codes: 0 ok · 1 usage/unknown key · 2 unusable model · 3 write failed
set -eu

STATE_DIR="${HOME:-/home/node}/.openclaw"
AGENT_MODELS_FILE="${AGENT_MODELS_FILE:-$STATE_DIR/agent-models.conf}"
LIB="$(dirname "$0")/agent-models.sh"
[ -r "$LIB" ] || LIB=/usr/local/bin/agent-models.sh
# shellcheck source=/dev/null
. "$LIB"

# key|what it selects the model for
#
# `planning` is deliberately its OWN key and not folded into `solver`.
# Estimating a story and implementing it are different jobs: estimation reads
# history and judges size, and a weaker model there produces bad numbers that
# then mis-schedule everything downstream. It also needs to stay switchable
# on its own — when the Kimi quota is spent, planning has to keep working on
# another provider even though nothing else changed.
#
# `solver.small` and `reviewer.small` are the cheap lane: a story estimated at
# or below solver.small.max_points (default 3) is implemented on
# `solver.small` INSTEAD of `solver`, and its pull request is reviewed on
# `reviewer.small` INSTEAD of `reviewer`.
#
# ONE threshold governs both, and it keeps the `solver.` name it shipped with.
# "Small" should mean one thing across the system: a story small enough for
# the cheap model to write but too large for it to read is a distinction
# nobody asked for and everybody would then have to reason about.
#
# Either key unset means that half of the lane is off — that work runs on
# `solver` / `reviewer` like everything else. That is deliberate: falling back
# to the environment baseline would make every deployment start routing
# differently the moment this shipped, without anyone choosing it. The runners
# therefore ask whether the key was explicitly set, not what it resolves to.
#
# An UNESTIMATED story is worth 8 points (story_points.DEFAULT_POINTS) and so
# never lands here. Under-estimating is the expensive direction — it is what
# makes a run die half-finished — so an unknown story gets the strong model.
KEYS='solver|the issue solver'"'"'s implementation turns
solver.small|implementing small stories (<= solver.small.max_points), when set
planning|story-point estimation and sprint planning
tester|the deployment tester'"'"'s run
reviewer|the pull-request reviewer'"'"'s run
reviewer.small|reviewing small stories'"'"' pull requests (same threshold), when set'

_known() { printf '%s\n' "$KEYS" | cut -d'|' -f1 | grep -qx "$1"; }
_desc_for() { printf '%s\n' "$KEYS" | awk -F'|' -v k="$1" '$1==k{print $2}'; }

# The models openclaw can actually resolve AND has credentials for.
#
# `models list` prints a table plus config warnings; only lines that start
# with provider/model are ours. The `configured` tag is the one that matters:
# a model listed without it has no auth profile, so a run on it would fail at
# the first request — which is precisely the breakage this command exists to
# prevent.
_available() {
  openclaw models list 2>/dev/null \
    | grep -E '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+[[:space:]]' \
    | grep -E '(^|[[:space:],])configured([[:space:],]|$)' \
    | awk '{print $1}'
}

# The model a key left at `default` actually runs on: the environment
# baseline pinned at deploy time, NOT whatever the chat is currently set to.
_baseline() { agent_model_baseline; }

# What the CHAT is on right now. Shown for contrast only — the two are
# independent by design, and seeing them side by side is the fastest way to
# confirm that switching one did not move the other.
_chat_model() {
  openclaw models list 2>/dev/null \
    | grep -E '^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+[[:space:]]' \
    | grep -E '(^|[[:space:],])default([[:space:],]|$)' \
    | awk '{print $1}' | head -1
}

_write() {  # atomic: a runner may read this file at any moment
  mkdir -p "$(dirname "$AGENT_MODELS_FILE")"
  _tmp="$AGENT_MODELS_FILE.tmp.$$"
  cat > "$_tmp" || return 3
  mv -f "$_tmp" "$AGENT_MODELS_FILE" || { rm -f "$_tmp"; return 3; }
}

_header() {
  cat <<'EOF'
# Which LLM each subsystem runs on. Managed from chat — see the `model`
# commands of the developer / tester / reviewer skills, or run `agent-models`.
#
# Read at the START of every runner, so a change applies to the next spawned
# run: nothing to restart, nothing to redeploy. A key that is missing or
# malformed inherits the global default rather than failing the run.
#
# This file lives on the workspace PVC, which is per environment: a model set
# on dev cannot affect prod.
EOF
}

_strip_key() {  # existing file minus one key, comments dropped
  { [ -r "$AGENT_MODELS_FILE" ] && sed 's/#.*//' "$AGENT_MODELS_FILE" | awk 'NF' \
      | grep -vE "^[[:space:]]*$(printf '%s' "$1" | sed 's/\./\\./g')[[:space:]]*=" || true; }
}

# The cheap-lane keys, whose UNSET state is "off" rather than "the baseline".
# Reported as such: `list` is where an operator checks whether the lane is on,
# and a `.small` row showing the baseline model would say the opposite of the
# truth — that small work is routed, when in fact nothing is.
_is_lane_key() { case "$1" in *.small) return 0 ;; *) return 1 ;; esac; }

cmd_list() {
  base="$(_baseline)"
  chat="$(_chat_model)"
  printf '%-15s %-34s %s\n' KEY MODEL SELECTS
  printf '%s\n' "$KEYS" | while IFS='|' read -r k desc; do
    if _is_lane_key "$k"; then
      m="$(agent_model_raw "$k" 2>/dev/null || true)"
      if [ -n "$m" ]; then
        printf '%-15s %-34s %s *\n' "$k" "$m" "$desc"
      else
        printf '%-15s %-34s %s\n' "$k" "off (not set)" "$desc"
      fi
      continue
    fi
    m="$(agent_model "$k" 2>/dev/null || true)"
    if [ -n "$m" ] && [ "$m" != "$base" ]; then
      printf '%-15s %-34s %s *\n' "$k" "$m" "$desc"
    else
      printf '%-15s %-34s %s\n' "$k" "${m:-?} (baseline)" "$desc"
    fi
  done
  echo
  echo "* = set explicitly for this environment. Everything else runs on the"
  echo "  baseline ${base:-<unset>}, pinned at deploy time. A .small key left"
  echo "  unset is OFF: that work runs on solver / reviewer, not on the baseline."
  echo
  echo "Chat is currently on ${chat:-?} — independent of the above. Switching the"
  echo "chat model does not move the runners, and setting a runner model here"
  echo "does not move the chat."
  echo "Store: $AGENT_MODELS_FILE"
}

# Prints the EFFECTIVE model — what the next run will actually use, whether
# that came from an explicit setting or the baseline. Callers asking "which
# model does the tester run on" want the answer, not the word "default"; use
# `list` to see which of the two it came from.
cmd_get() {
  [ $# -ge 1 ] || { echo "usage: agent-models get <key>" >&2; return 1; }
  _known "$1" || { echo "unknown key: $1 (see: agent-models list)" >&2; return 1; }
  if _is_lane_key "$1"; then
    # Same reason as in cmd_list: for a lane key the effective answer when
    # nothing was set is "off", not the baseline the fallback would report.
    m="$(agent_model_raw "$1" 2>/dev/null || true)"
    printf '%s\n' "${m:-off (not set)}"
    return 0
  fi
  m="$(agent_model "$1" 2>/dev/null || true)"
  printf '%s\n' "${m:-<inherited, no baseline pinned>}"
}

cmd_available() {
  base="$(_baseline)"
  chat="$(_chat_model)"
  echo "Models openclaw can run here (credentials present):"
  _available | while read -r m; do
    tag=""
    [ "$m" = "$base" ] && tag="   <- runner baseline"
    [ "$m" = "$chat" ] && tag="$tag   <- chat is on this"
    echo "  $m$tag"
  done
}

_set_one() {  # <key> <value-already-validated>
  _strip_key "$1" > "/tmp/am.$$"
  { _header; cat "/tmp/am.$$"; [ "$2" = "default" ] || echo "$1 = $2"; } | _write
  rm -f "/tmp/am.$$"
}

cmd_set() {
  [ $# -ge 2 ] || { echo "usage: agent-models set <key>|all <model-id>|default" >&2; return 1; }
  key="$1"; val="$2"
  [ "$key" = "all" ] || _known "$key" || { echo "unknown key: $key (see: agent-models list)" >&2; return 1; }

  case "$val" in
    default|inherit|auto) val=default ;;
    *)
      # Strict here on purpose: this is the one place a human sees the
      # refusal. Letting an unresolvable model through would kill every run
      # the subsystem starts, and the planner would respawn them forever.
      avail="$(_available)"
      if [ -z "$avail" ]; then
        echo "cannot read the model list from openclaw — refusing to set a model I cannot verify" >&2
        echo "  (try: openclaw models list)" >&2
        return 2
      fi
      if ! printf '%s\n' "$avail" | grep -qx "$val"; then
        echo "not a usable model: $val" >&2
        echo "  usable models here:" >&2
        printf '%s\n' "$avail" | sed 's/^/    /' >&2
        echo "  a model missing from this list has no credentials configured," >&2
        echo "  so every run on it would fail at the first request." >&2
        return 2
      fi
      ;;
  esac

  if [ "$key" = "all" ]; then
    for k in $(printf '%s\n' "$KEYS" | cut -d'|' -f1); do _set_one "$k" "$val"; done
    if [ "$val" = default ]; then
      echo "all subsystems back to the config default"
    else
      echo "all subsystems -> $val"
    fi
  else
    _set_one "$key" "$val"
    if [ "$val" = default ]; then
      echo "$key -> config default (inherited)"
    else
      echo "$key -> $val"
    fi
  fi
  echo "Applies to the next run that starts; anything in flight keeps its model."
}

cmd_reset() {
  [ $# -ge 1 ] || { echo "usage: agent-models reset <key>|all" >&2; return 1; }
  if [ "$1" = "all" ]; then
    _header | _write
    echo "all subsystems back to the config default"
    return 0
  fi
  _known "$1" || { echo "unknown key: $1" >&2; return 1; }
  _set_one "$1" default
  echo "$1 back to the config default (inherited)"
}

case "${1:-list}" in
  list)      shift 2>/dev/null || true; cmd_list ;;
  get)       shift; cmd_get "$@" ;;
  set)       shift; cmd_set "$@" ;;
  reset)     shift; cmd_reset "$@" ;;
  available) shift 2>/dev/null || true; cmd_available ;;
  -h|--help|help) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown command: $1" >&2; sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1 ;;
esac
