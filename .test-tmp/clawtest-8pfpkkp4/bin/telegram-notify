#!/bin/bash
# telegram-notify "<message>"
#
# Proactively DM the bot owner on Telegram. Used by the issue-solver, the
# reviewer and the deployment-tester to report progress ("finished issue #N",
# "review posted", "test run complete", "blocked — please reply").
#
# WHY A WRAPPER AND NOT AN INLINE SNIPPET
# The same twelve lines of chat-id resolution were already copy-pasted into
# tester-runner.sh, and every new subsystem that wants to report would have
# copied them again. Worse, each copy would have had to re-decide what to do
# when no chat is paired — and a subsystem that treats "owner never messaged
# the bot" as a hard error takes down a run over a notification.
#
# WHERE THE TARGET COMES FROM
# openclaw records a paired Telegram chat in its own state as an
# `ownerAllowFrom` entry of the form "telegram:<chat_id>". That is the only
# source of truth used here: no hardcoded chat ids, no usernames baked into a
# wrapper or a prompt, so the image is identity-agnostic and the same build
# runs for any owner.
#
# The live state file is the merged one openclaw writes at ~/.openclaw/
# openclaw.json. The render step deep-merges commands.ownerAllowFrom from the
# PVC copy into it at pod start, so a pairing survives a redeploy — which is
# why this reads the live file and not the ConfigMap template.
#
# FAILS OPEN, ALWAYS
# Exit 0 on every path — unknown chat, delivery failure, malformed state. A
# notification is the least important thing any caller is doing; it must never
# be the thing that fails the run. Callers therefore need no `|| true`.
set -uo pipefail
MSG="${1:?usage: telegram-notify <message>}"

TARGET="$(python3 - <<'PY' 2>/dev/null
import json, os

home = os.path.expanduser("~/.openclaw")

target = ""
try:
    with open(os.path.join(home, "openclaw.json"), encoding="utf-8") as f:
        d = json.load(f)
    for entry in (d.get("commands", {}) or {}).get("ownerAllowFrom", []) or []:
        if isinstance(entry, str) and entry.startswith("telegram:"):
            target = entry.split(":", 1)[1]
            break
except Exception:
    pass
print(target)
PY
)"

if [ -z "$TARGET" ]; then
  echo "[telegram-notify] no paired Telegram chat yet (owner must message the bot once) — skipping"
  exit 0
fi

if openclaw message send --channel telegram --target "$TARGET" -m "$MSG" >/dev/null 2>&1; then
  echo "[telegram-notify] delivered to $TARGET"
else
  echo "[telegram-notify] delivery to $TARGET failed"
fi
exit 0
