#!/bin/sh
# Fake `forge-cli` for the test suite: serves canned answers from a fixture
# directory, and records every call.
#
# WHY THIS REPLACED THE FAKE CURL FOR THE RUNNERS
# The runners no longer speak HTTP. They ask questions — "what is this issue",
# "are the checks green", "close this as delivered" — and a test that stubbed
# URLs would be pinning a shape no runner can see any more.
#
# HOW AN ANSWER IS CHOSEN
# The verb and the values that identify WHAT is being asked about are reduced
# to a slug and looked up in $FAKE_FORGE_DIR:
#
#     issue --number 5           ->  issue_5, then issue
#     checks --sha abc123        ->  checks_abc123, then checks
#     change-request --number 2  ->  change-request_2, then change-request
#
# The most specific fixture wins, so a test pins one item and leaves the rest
# on a default.
#
# A MISSING FIXTURE IS A FAILURE, NOT AN EMPTY ANSWER. It exits 1 and prints
# nothing, exactly as the real command does for a read it could not answer —
# because a stand-in that treated "no fixture" as "no comments" would let a
# test pass while production did something else entirely. Write verbs are the
# exception: they succeed with no fixture, since having nothing canned to
# return is the normal case for a write.
#
# $FAKE_FORGE_LOG receives one line per call, so a test can assert that a gate
# wrote NOTHING — which is how you pin "refuses to merge" rather than merely
# "returned 1".
#
# $FAKE_FORGE_FAIL is a space-separated list of verbs that must fail, for
# testing what a runner does when a write is refused.

DIR="${FAKE_FORGE_DIR:-}"
LOG="${FAKE_FORGE_LOG:-}"

# Everything a fixture may be keyed on. --repo is deliberately NOT among them:
# a test pins an item, not a project.
verb=""
key=""
_prev=""
for a in "$@"; do
  case "$_prev" in
    --number|--sha|--branch|--path|--ref|--label|--name|--comment-id)
      key="${key}_${a}" ;;
  esac
  case "$a" in
    --*) ;;
    *)
      case "$_prev" in
        --repo|--number|--sha|--branch|--path|--ref|--label|--name|--color|--description|--labels|--assignees|--title|--body-file|--emoji|--verdict|--reviewers|--state|--limit|--comment-id) ;;
        *) [ -n "$verb" ] || verb="$a" ;;
      esac ;;
  esac
  _prev="$a"
done

[ -z "$LOG" ] || echo "$verb$key $*" >> "$LOG"

for v in $FAKE_FORGE_FAIL; do
  [ "$v" = "$verb" ] && exit 1
done

if [ -n "$DIR" ]; then
  # Most specific first.
  if [ -n "$key" ] && [ -f "$DIR/$verb$key" ]; then
    cat "$DIR/$verb$key"
    exit 0
  fi
  if [ -f "$DIR/$verb" ]; then
    cat "$DIR/$verb"
    exit 0
  fi
fi

# No fixture. A write is fine; a read is not.
case "$verb" in
  comment|add-labels|remove-label|ensure-label|close-issue|submit-review\
  |request-review|unrequest-review|merge|react|comment-on-commit\
  |comment-on-change-request|close-change-request|delete-branch)
    exit 0 ;;
esac
exit 1
