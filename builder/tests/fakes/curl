#!/bin/sh
# Fake `curl` for the test suite: serves canned API responses from a
# fixture directory, and records every request.
#
# WHY
# The runners reach the API through dozens of curl calls, and everything interesting
# they do — the merge scope guard, the review gate, the On Hold lifecycle, the
# note cursor — is a decision taken on a response body. None of it was
# testable without a live server, a token and a repository to scribble on.
#
# HOW A RESPONSE IS CHOSEN
# The request URL is reduced to a slug and looked up in $FAKE_CURL_DIR:
#
#     .../repos/owner/name/pulls/2  ->  repos_owner_name_pulls_2
#
# The longest matching fixture wins, so a test can pin one specific endpoint
# and leave the rest on a default. A missing fixture is NOT silently empty: it
# exits non-zero like `curl -f` on a 404, because a function that quietly
# treats "no fixture" as "empty response" would pass a test while doing
# something else entirely in production.
#
# $FAKE_CURL_LOG receives one line per request, so a test can assert that a
# function did NOT call an endpoint — which is how you pin "refuses to merge"
# rather than merely "returned 1".

DIR="${FAKE_CURL_DIR:-}"
LOG="${FAKE_CURL_LOG:-}"

# The URL is the last argument that looks like one; everything else is flags,
# headers and data we do not care about here.
url=""
method="GET"
_prev=""
for a in "$@"; do
  case "$a" in
    http://*|https://*) url="$a" ;;
  esac
  case "$_prev" in
    -X|--request) method="$a" ;;
  esac
  _prev="$a"
done

[ -z "$LOG" ] || printf '%s %s\n' "$method" "$url" >> "$LOG" 2>/dev/null

[ -n "$DIR" ] || exit 0

# Strip the scheme, the host and the API prefix, then reduce to a filename.
#
# Dropping `api/v4/` is what lets a fixture be named after the API path a
# reader recognises — projects/g%2Fp/issues/3 — instead of carrying a prefix
# that is the same on every single request.
path="${url#*://}"
path="${path#*/}"
path="${path#api/v4/}"
path="${path#api/graphql}"
slug=$(printf '%s' "$path" \
  | sed 's/[?#].*$//; s/%2F/_/g; s/%2f/_/g; s#[/.]#_#g; s/[^A-Za-z0-9_-]/_/g')

# Longest match first: repos_owner_name_pulls_2_comments beats
# repos_owner_name_pulls_2.
candidate=""
while [ -n "$slug" ]; do
  if [ -f "$DIR/${method}_${slug}" ]; then candidate="$DIR/${method}_${slug}"; break; fi
  if [ -f "$DIR/$slug" ]; then candidate="$DIR/$slug"; break; fi
  case "$slug" in
    *_*) slug="${slug%_*}" ;;
    *) slug="" ;;
  esac
done

if [ -z "$candidate" ]; then
  # Behave like `curl -f`: a 4xx is a non-zero exit and no body. Callers that
  # treat a failed fetch as an empty result must be seen doing so.
  exit 22
fi
cat "$candidate"
