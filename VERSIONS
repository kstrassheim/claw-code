# claw-code version pins — single source of truth.
# Read by .github/workflows/validate.yml and .github/workflows/deploy.yml.
# Bump a value here and a PR / merge will rebuild the image with it.

# Upstream openclaw base image (FROM in builder/Dockerfile).
# Tag matches https://github.com/openclaw/openclaw releases.
# Its layer count eats into the Dockerfile's layer budget: when this moves,
# update BASE_LAYERS in builder/tests/test_dockerfile_layer_order.py, or a
# daemon-loaded build fails late with `max depth exceeded` (v2026.10.4 went
# from 26 to 41).
OPENCLAW_UPSTREAM=v2026.10.4

# The upstream bridge release the bridge-state initContainer runs. State written
# before July 2026 (this project's v2026.7.1 era) must pass through this
# release's `doctor --fix` before any 2026.10.x will open it: the retired
# plugin and workspace JSON imports live here and nowhere later. Mirrored into
# ACR as openclaw-base:<this>, like OPENCLAW_UPSTREAM. ghcr's tag has no
# leading "v".
OPENCLAW_BRIDGE=v2026.9.5

# The tag this project's OWN image is published under, and the thing the build
# skips on. Bump the trailing .N for any change to builder/ that must reach the
# cluster; leave it alone and the deploy reuses the image already in ACR
# instead of rebuilding it.
OPENCLAW_VERSION=v2026.10.4.3

# Tools baked into the openclaw image.
GH_CLI_VERSION=2.102.0
GITHUB_MCP_SERVER_VERSION=2.0.2
AWS_CLI_VERSION=2.38.1
GCLOUD_VERSION=589.0.0
ALIYUN_CLI_VERSION=3.5.1
TERRAFORM_VERSION=1.16.6

# OpenTofu drives the CI pipelines. Terraform stays pinned above because the
# BUILDER IMAGE still ships it for terraform-mcp — the agent may be pointed at
# a Terraform-managed project, and reading one does not mean managing this one
# with it. The two pins are independent on purpose.
TOFU_VERSION=1.12.6
TERRAFORM_MCP_VERSION=1.3.0
CODE_SERVER_VERSION=4.141.0

