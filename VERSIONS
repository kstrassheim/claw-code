# claw-code version pins — single source of truth.
# Read by .github/workflows/validate.yml and .github/workflows/deploy.yml.
# Bump a value here and a PR / merge will rebuild the image with it.

# Upstream openclaw base image (FROM in builder/Dockerfile).
# Tag matches https://github.com/openclaw/openclaw releases.
# Its layer count eats into the Dockerfile's layer budget: when this moves,
# update BASE_LAYERS in builder/tests/test_dockerfile_layer_order.py, or a
# daemon-loaded build fails late with `max depth exceeded` (v2026.10.4 went
# from 26 to 41).
OPENCLAW_UPSTREAM=v2026.10.7

# The upstream bridge release the bridge-state initContainer runs. State written
# before July 2026 (this project's v2026.7.1 era) must pass through this
# release's `doctor --fix` before any 2026.10.x will open it: the retired
# plugin and workspace JSON imports live here and nowhere later. Mirrored into
# ACR as openclaw-base:<this>, like OPENCLAW_UPSTREAM. ghcr's tag has no
# leading "v".
OPENCLAW_BRIDGE=v2026.9.5

# The tag this project's OWN image is published under, and the thing the build
# skips on. Bump the trailing .N for any change to builder/ that must reach the
# cluster; leave it alone and the deploy reuses the image already in ACR
# instead of rebuilding it.
OPENCLAW_VERSION=v2026.10.7.1

# Tools baked into the openclaw image.
GH_CLI_VERSION=2.103.3
GITHUB_MCP_SERVER_VERSION=2.0.3
AWS_CLI_VERSION=2.38.6
GCLOUD_VERSION=590.0.1
ALIYUN_CLI_VERSION=3.5.2
TERRAFORM_VERSION=1.17.0

# OpenTofu drives the CI pipelines. Terraform stays pinned above because the
# BUILDER IMAGE still ships it for terraform-mcp — the agent may be pointed at
# a Terraform-managed project, and reading one does not mean managing this one
# with it. The two pins are independent on purpose.
TOFU_VERSION=1.13.2
TERRAFORM_MCP_VERSION=1.4.1
CODE_SERVER_VERSION=4.143.1

# ---------------------------------------------------------------------------
# Pins carried over with the claw-code-local toolchain: the security passes
# (semgrep, bandit, gitleaks, nuclei, testssl, pip-audit), the PowerShell and
# .NET stacks the reviewer needs, mermaid rendering, kubelogin, and OpenTofu.
# ---------------------------------------------------------------------------
BANDIT_VERSION=1.9.4
# dotnet-install.sh CHANNELS, comma-separated, installed side by side: each
# project's global.json picks its own band (a latestFeature pin on 8.0 refuses
# a 10.0 SDK). 10.0 is the current LTS; drop 8.0 once nothing pins it — it
# leaves support on 2026-11-10.
DOTNET_SDK_CHANNELS=10.0,8.0
GITLEAKS_VERSION=8.30.1
GIT_LFS_VERSION=3.8.1
KUBELOGIN_VERSION=0.2.22
MERMAID_CLI_VERSION=11.17.0
NUCLEI_TEMPLATES_VERSION=10.5.1
NUCLEI_VERSION=3.11.1
OPENTOFU_MCP_VERSION=0.1.5
OPENTOFU_VERSION=1.13.2
PESTER_VERSION=6.2.0
PIP_AUDIT_VERSION=2.10.1
PSSCRIPTANALYZER_VERSION=1.25.0
PWSH_VERSION=7.6.9
PYMONGO_VERSION=4.19.0
SEMGREP_MCP_VERSION=0.9.0
SEMGREP_VERSION=1.182.1
SQLPACKAGE_VERSION=170.5.96
TESTSSL_VERSION=3.2.4

# Gitea and Azure DevOps: the CLI and MCP for each, added with the forge
# modules that talk to them.
TEA_VERSION=0.16.0
GITEA_MCP_VERSION=1.11.0
AZDO_MCP_VERSION=2.11.0

# GitLab: the CLI and the MCP server TOOLS-gitlab.md names.
GLAB_VERSION=1.124.0
GITLAB_MCP_VERSION=0.9.1
AZ_VERSION=16.4.0
